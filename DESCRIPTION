Package: bigWig
Type: Package
Title: R Interface to Query UCSC BigWig Files
Version: 0.99.1
Date: 2026-10-26
Authors@R: c(
    person("Andre L.", "Martins", role = "aut",
           comment = "Original author, Cornell University"),
    person("Luther", "Vucic", role = "aut"),
    person("Michael J.", "Guertin", role = c("aut", "cre"),
           email = "guertin@uchc.edu",
